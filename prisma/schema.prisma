datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed, for credentials auth
  accounts      Account[]
  sessions      Session[]
  savedColleges SavedCollege[]
  reviews       Review[]
  questions     Question[]
  answers       Answer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model College {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  location      String
  city          String
  state         String
  type          String   // "Government" | "Private" | "Deemed"
  established   Int?
  ranking       Int?
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  imageUrl      String?
  bannerUrl     String?
  website       String?
  description   String   @db.Text
  fees          Json     // { min: number, max: number, currency: "INR" }
  placements    Json     // { averageSalary: number, highestSalary: number, topRecruiters: string[], placementRate: number }
  facilities    String[] // ["Library", "Hostel", "Sports", ...]
  courses       Course[]
  reviews       Review[]
  savedBy       SavedCollege[]
  predictorData PredictorData[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Course {
  id         String  @id @default(cuid())
  name       String
  duration   Int     // in years
  fees       Float
  seats      Int
  collegeId  String
  college    College @relation(fields: [collegeId], references: [id])
}

model Review {
  id           String   @id @default(cuid())
  rating       Float
  title        String
  body         String   @db.Text
  pros         String?
  cons         String?
  batch        Int?     // graduation year
  userId       String
  collegeId    String
  user         User     @relation(fields: [userId], references: [id])
  college      College  @relation(fields: [collegeId], references: [id])
  createdAt    DateTime @default(now())
}

model SavedCollege {
  id        String  @id @default(cuid())
  userId    String
  collegeId String
  user      User    @relation(fields: [userId], references: [id])
  college   College @relation(fields: [collegeId], references: [id])
  savedAt   DateTime @default(now())
  @@unique([userId, collegeId])
}

model PredictorData {
  id         String  @id @default(cuid())
  collegeId  String
  exam       String  // "JEE_MAIN" | "JEE_ADVANCED" | "CAT" | "NEET" | "STATE_CET"
  category   String  // "GENERAL" | "OBC" | "SC" | "ST" | "EWS"
  branch     String
  openingRank Int
  closingRank Int
  year       Int
  college    College @relation(fields: [collegeId], references: [id])
  @@index([exam, category, closingRank])
}

model Question {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  answers   Answer[]
  createdAt DateTime @default(now())
}

model Answer {
  id         String   @id @default(cuid())
  body       String   @db.Text
  userId     String
  questionId String
  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now())
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
